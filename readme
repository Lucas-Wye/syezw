# Debug
```
$env:http_proxy="http://127.0.0.1:7897"
$env:https_proxy="http://127.0.0.1:7897"
$env:JAVA_TOOL_OPTIONS='-DproxySet=true -DproxyHost=127.0.0.1 -DproxyPort=7897'

export http_proxy="http://127.0.0.1:7897"
export https_proxy="http://127.0.0.1:7897"
export JAVA_TOOL_OPTIONS='-DproxySet=true -DproxyHost=127.0.0.1 -DproxyPort=7897'

./gradlew test
./gradlew compileDebugSources
./gradlew assembleDebug
./gradlew ktlintFormat
```

# Release
```
keytool -genkeypair -alias syezw_release -keyalg RSA -keysize 2048 -validity 10000 -keystore ./app/release.keystore
```

```
$env:RELEASE_STORE_FILE="release.keystore"
$env:RELEASE_STORE_PASSWORD="syezw2026"
$env:RELEASE_KEY_ALIAS="syezw_release"
$env:RELEASE_KEY_PASSWORD="syezw2026"

export RELEASE_STORE_FILE=release.keystore
export RELEASE_STORE_PASSWORD=syezw2026
export RELEASE_KEY_ALIAS=syezw_release
export RELEASE_KEY_PASSWORD=syezw2026
```
./gradlew compileReleaseSources
./gradlew assembleRelease
```

# Java Downlaod

https://mirrors.tuna.tsinghua.edu.cn/Adoptium/20/jdk

for Windows:
```
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-20.0.2.9-hotspot
ClassPath=.;%JAVA_HOME%\lib\dt.jar;%JAVA_HOME%\lib\tools.jar;
PATH=%JAVA_HOME%\bin;%JAVA_HOME%\jre\bin
```

# Android SDK Download

https://developer.android.google.cn/studio?hl=zh-cn#command-line-tools-only

```

sdkmanager.bat --list --sdk_root=D:\software\bin\android\sdk > 1.log
sdkmanager --sdk_root=D:\software\bin\android\sdk "platforms;android-30" "build-tools;30.0.0"

sdkmanager --sdk_root=D:\software\bin\android\sdk "emulator" "system-images;android-34;google_apis;x86_64"
```

`sdkmanager` is too old, use `android` instead
```
export ANDROID_SDK_ROOT=~/Library/Android/sdk
android sdk install "platforms;android-30" "build-tools;30.0.0"
```

# DB
```
# Backend uses SQLite. Set DATABASE_URL if the database file should live elsewhere.
# Default: sqlite://syezw.db (relative to the backend working directory).
sqlite3 backend/syezw.db
.tables

DELETE FROM diary_sync;
DELETE FROM todo_sync;
DELETE FROM period_sync;
DELETE FROM diary_images;
DELETE FROM diary_image_refs;

SELECT * FROM diary_sync;
SELECT * FROM todo_sync;
SELECT * FROM period_sync;
SELECT * FROM diary_images;
SELECT * FROM diary_image_refs;

SELECT COUNT(*) FROM diary_sync;
SELECT COUNT(*) FROM todo_sync;
SELECT COUNT(*) FROM period_sync;
SELECT COUNT(*) FROM diary_images;
SELECT COUNT(*) FROM diary_image_refs;

DROP TABLE IF EXISTS;
```
